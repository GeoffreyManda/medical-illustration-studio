{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "scope",
    "create",
    "modify",
    "delete"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "create": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+$"
      }
    },
    "modify": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+$"
      }
    },
    "delete": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9_./-]+$"
      }
    }
  }
}
