{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "frames",
    "active_frame",
    "references",
    "brief",
    "style"
  ],
  "properties": {
    "schema_version": {
      "const": "2.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,99}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "document",
          "stage",
          "show_labels",
          "detail",
          "hidden_layers",
          "geometry_locked",
          "artwork_media_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "template_id": {
            "type": "string",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "kind": {
            "enum": [
              "plate",
              "scene",
              "graphics"
            ]
          },
          "document": {
            "type": "object"
          },
          "stage": {
            "enum": [
              "colour",
              "values",
              "contours"
            ]
          },
          "show_labels": {
            "type": "boolean"
          },
          "detail": {
            "type": "number",
            "minimum": 0,
            "maximum": 1.5
          },
          "hidden_layers": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 150
            },
            "uniqueItems": true,
            "maxItems": 200
          },
          "geometry_locked": {
            "type": "boolean"
          },
          "artwork_media_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          }
        }
      }
    },
    "active_frame": {
      "type": "string",
      "maxLength": 100
    },
    "references": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "url",
          "note",
          "licence",
          "media_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "maxLength": 240
          },
          "url": {
            "type": "string",
            "maxLength": 3000
          },
          "note": {
            "type": "string",
            "maxLength": 60000
          },
          "licence": {
            "type": "string",
            "maxLength": 500
          },
          "media_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 100
          }
        }
      }
    },
    "brief": {
      "type": "string",
      "maxLength": 20000
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "locked"
      ],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "locked": {
          "type": "boolean"
        }
      }
    }
  }
}
